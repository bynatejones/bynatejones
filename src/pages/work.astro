---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
	title="Cinematography"
	description=""
>
	<div class="stack gap-20">
		<main class="wrapper stack gap-8">
			<Hero
				title="Cinematography"
				tagline=""
				align="start"
			/>

            <Grid>
                <iframe src="https://player.vimeo.com/video/271437390?h=655833f2e7" width="640" height="272" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>

                <iframe src="https://player.vimeo.com/video/257804857?h=1a91077a5d" width="640" height="272" frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
            </Grid>
            

			<Grid variant="offset">
				<!-- {
					projects.map((project) => (
						<li>
							<PortfolioPreview project={project} />
						</li>
					))
				} -->

                <img class="portfolio-img" src="/assets/portfolio/faerie01.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/faerie009.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/faerie034.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/faerie036.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/faerie048.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/grand-falls-2.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/grand-falls-4.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/sky-4-scaled.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/still001.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/still003-1-scaled.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/still004.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/still006.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/still014.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/still015.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/still020.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/still028.jpg"/>
                <img class="portfolio-img" src="/assets/portfolio/yosemite.jpg"/>
			</Grid>
		</main>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
    .portfolio-img {
        border-radius: 0.6rem;
    }
</style>
