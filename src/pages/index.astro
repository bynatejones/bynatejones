// Full Astro Component Syntax:
// https://docs.astro.build/core-concepts/astro-components/
---

<BaseLayout>
    <div class="stack gap-20 lg:gap-2">
        <div class="wrapper stack gap-8 lg:gap-20 header">
            <header class="hero">
                <Hero
                    title="Nate Jones"
                    icon="/assets/iatse600_circle_640x640.png"
                    tagline="ICG 600 1st Assistant Camera, Cinematographer and Colorist"
                    taglinetwo="LOS ANGELES / TRAVEL-READY"
                    align="start"
                >
                </Hero>
                <div class="nate-photo" style="width: 100%; text-align: right;">
                    <img
                        alt="Nate Jones portrait photo"
                        width="1326"
                        src="/assets/nate-profile-2.jpg"
                    />
                </div>
            </header>
        </div>

        <!-- Add the BrandCloud component here -->
        <BrandCloud />

		<!-- Add this after BrandCloud component -->
		<div class="featured-work wrapper">
			<FeaturedWorkSection 
				title="Commercials" 
				projects={commercialProjects} 
			/>
			<FeaturedWorkSection 
				title="Music Videos" 
				projects={musicVideoProjects} 
			/>
			<FeaturedWorkSection 
				title="Narrative" 
				projects={narrativeProjects} 
			/>
		</div>

        <script>
            // this code adjusts the height of the list based on
            // the number of items, so columns stay the same size
            // and they don't overflow off the page
            import ResumeData from '../data/resume.json';
            var resumeCount = ResumeData.length;
            var count = (resumeCount - 52) * 18;
            document.getElementById('resume-list').style.maxHeight = 1020 + count + "px";
        </script>
        <main class="resume-wrapper wrapper stack gap-2 lg:gap-48">
            <ul id="resume-list" class="resume-list">
                {
                    // sort json reverse chronologically and map it to html
                  ResumeData.sort((a, b) => parseInt(b.date) - parseInt(a.date)).map(({ date, title, type, role, camera }) => (
                    <li class="resume-list-item">
                      <p class="resume-top-line"><i><span class="resume-date">{date.split("")[2] + date.split("")[3] + "/" + date.split("")[0] + date.split("")[1]} ● {role}</span></i></p>
                      <p class="resume-middle-line">{title}</p>
                      <p class="resume-bottom-line"> {type} // {camera}</p>
                    </li>
                    <hr class="resume-list-divider"/>
                  ))
                }
              </ul>
        </main>
