---
import BaseLayout from '../layouts/BaseLayout.astro';

import Hero from '../components/Hero.astro';
import BrandCloud from '../components/BrandCloud.astro';

import ResumeData from '../data/resume.json';

// Reverse chronological. Dates are stored as "YYMM".
const credits = [...ResumeData].sort((a, b) => parseInt(b.date) - parseInt(a.date));
---
<BaseLayout>
    <div class="stack gap-4 lg:gap-2">
        <div class="wrapper stack gap-8 lg:gap-20 header">
            <header class="hero">
                <Hero
                    title="NATE JONES"
                    icon="/assets/iatse600_circle_640x640.png"
                    tagline="ICG 600 1st Assistant Camera ● Cinematographer ● Colorist"
                    taglinetwo="LOS ANGELES // TRAVEL-READY"
                    align="start"
                >
                </Hero>
                <div class="nate-photo" style="text-align: right;">
                    <img
                        alt="Nate Jones portrait photo"
                        src="/assets/nate-profile-2.jpg"
                        width="250"
                        height="250"
                        fetchpriority="high"
                        style="width: 250px; height: 250px; object-fit: cover; text-align: right;"
                    />
                </div>
            </header>
        </div>

        <BrandCloud />

        <div style="max-width: 1200px; width: 90%; margin: 1rem auto;">
            <hr style="border: 0; border-top: 2px solid #f0c91c;"/>
        </div>
        <main class="resume-wrapper wrapper">
            <ul id="resume-list" class="resume-list">
                {
                    // sort json reverse chronologically and map it to html
                  credits.map(({ date, title, type, role, camera }) => (
                    <li class="resume-list-item">
                      <p class="resume-top-line"><i><span class="resume-date">{date.slice(2, 4)}/{date.slice(0, 2)} ● {role}</span></i></p>
                      <p class="resume-middle-line">{title}</p>
                      <p class="resume-bottom-line">{type}{camera && ` // ${camera}`}</p>
                    </li>
                  ))
                }
              </ul>
        </main>
    </div>
</BaseLayout>

<style>
    /* Same max width as the .header box above. */
    .resume-wrapper {
        max-width: 1200px;
        padding-block: 1rem 3rem;
    }

    /* Up to 4 columns, each at least 17rem wide. The browser balances the
       columns and drops to fewer columns (down to 1) as the screen narrows. */
    .resume-list {
        list-style: none;
        padding: 0;
        columns: 4 17rem;
        column-gap: 2.5rem;
    }

    .resume-list-item {
        break-inside: avoid;
        padding: 0.6rem 0 0.7rem;
        border-bottom: 2px solid #283044;
        overflow-wrap: anywhere;
    }

    .resume-top-line {
        font-size: 0.8rem;
        line-height: 1rem;
        font-weight: 200;
        color: #a7a7a7;
    }

    .resume-date {
        font-size: 0.8rem;
    }

    .resume-middle-line {
        font-size: 1.3rem;
        line-height: 1.4rem;
        font-weight: 900;
        color: var(--accent-regular);
        font-variant-caps: all-small-caps;
    }

    .resume-bottom-line {
        font-size: 1.1rem;
        line-height: 1.2rem;
        color: #fff;
        font-weight: 500;
        font-variant-caps: all-small-caps;
    }

    /* Single column on phones: centre everything. */
    @media (max-width: 36em) {
        .resume-list-item {
            text-align: center;
        }

        .resume-top-line {
            font-size: 0.9rem;
        }

        .resume-middle-line {
            font-size: 1.5rem;
            line-height: 1.6rem;
        }

        .resume-bottom-line {
            font-size: 1.2rem;
            line-height: 1.4rem;
        }
    }

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.hero img {
		aspect-ratio: 1.2 / 1;
		object-fit: cover;
		object-position: top;
		border-radius: 0.7rem;
	}

	@media (min-width: 50em) {
		.hero {
			display: grid;
			grid-template-columns: 6fr 4fr;
			padding-inline: 2.5rem;
			gap: 3.75rem;
		}

		.hero img {
			border-radius: 0.5rem;
		}
	}
</style>
