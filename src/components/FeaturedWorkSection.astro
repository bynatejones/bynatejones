---
interface Props {
    title: string;
    projects: {
        title: string;
        thumbnail: string;
        videoUrl: string;
        description?: string;
    }[];
}

const { title, projects } = Astro.props;
---

<section class="featured-work-section">
    <h2 class="section-title">
        <span>{title}</span>
        <div class="line"></div>
    </h2>
    <div class="projects-grid">
        {projects.map(project => (
            <a href={project.videoUrl} target="_blank" class="project-card">
                <div class="thumbnail">
                    <img src={project.thumbnail} alt={project.title} />
                </div>
                <div class="project-info">
                    <h3>{project.title}</h3>
                    {project.description && <p>{project.description}</p>}
                </div>
            </a>
        ))}
    </div>
</section>

<style>
    .featured-work-section {
        padding: 2rem 0;
        background-color: transparent;
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .section-title span {
        color: white;
        font-size: 1.8rem;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .line {
        height: 2px;
        background-color: var(--accent-regular);
        flex-grow: 1;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
        padding: 0 1rem;
    }

    .project-card {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1rem;
        border-radius: 0.5rem;
        /* background-color: var(--gray-999); */
        transition: transform 0.3s ease;
        text-decoration: none;
        /* border: 1px solid var(--gray-800); */
    }

    .project-card:hover {
        transform: translateY(-2px);
        /* background-color: var(--gray-900); */
    }

    .thumbnail {
        flex-shrink: 0;
        width: 180px;
        height: 100px;
        border-radius: 0.3rem;
        overflow: hidden;
    }

    .thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .project-info {
        flex-grow: 1;
    }

    .project-info h3 {
        margin: 0;
        font-size: 1.2rem;
        color: var(--accent-regular);
    }

    .project-info p {
        margin: 0.5rem 0 0;
        font-size: 0.9rem;
        color: var(--gray-300);
    }

    @media (max-width: 900px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .project-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .thumbnail {
            width: 100%;
            height: 180px;
        }
    }
</style>