---
const brands = [
  { name: 'Netflix', logo: '/assets/brands/netflix.png' },
  { name: 'Amazon Studios', logo: '/assets/brands/amazon-studios.png' },
  { name: 'Warner Bros', logo: '/assets/brands/warner-bros.png' },
  { name: 'Apple', logo: '/assets/brands/apple.png' },
  { name: 'Nike', logo: '/assets/brands/nike.png' },
  { name: 'Adidas', logo: '/assets/brands/adidas.png' },
  { name: 'Lexus', logo: '/assets/brands/lexus.png' },
  { name: 'Nissan', logo: '/assets/brands/nissan.png' },
  { name: 'ESPN', logo: '/assets/brands/espn.png' },
  { name: 'Waymo', logo: '/assets/brands/waymo.png' },
  { name: 'Polymarket', logo: '/assets/brands/polymarket.png' },
  { name: 'Kaiser Permanente', logo: '/assets/brands/kaiser-permanente.png' },
];
---


<div class="brands-container">
  <div class="brands-grid">
    {
      brands.map((brand) => (
        <div class="brand-item">
          <img src={brand.logo} alt={`${brand.name} logo`} loading="lazy" />
        </div>
      ))
    }
  </div>
</div>

<style>
  .brands-container {
    padding: 2rem 0;
    margin: 1em auto;
    width: 100%;
    max-width: 1200px;
  }

  /* 12 logos: 3 per row on phones (3x4), 4 on tablets (4x3), 6 on desktop (6x2). */
  .brands-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 1.25rem;
    align-items: center;
    justify-items: center;
    padding: 0 1rem;
  }

  .brand-item {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    max-width: 9rem;
    height: 3.25rem;
  }

  .brand-item img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(2px 2px 0 black) drop-shadow(-2px -2px 0 black);
  }

  @media (min-width: 40em) {
    .brands-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem 2.5rem;
    }

    .brand-item {
      height: 4.5rem;
    }
  }

  @media (min-width: 64em) {
    .brands-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
